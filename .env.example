BOT_TOKEN=your-bot-token-from-botfather
ADMIN_TELEGRAM_ID=123456789
GROUP_CHAT_ID=-100123456789
# Language for all user-facing bot text: fa (Persian, default) or en (English).
BOT_LANG=fa
SNAPSHOT_HOUR=12
SESSION_WEEKDAY=monday
MAX_ATTENDEES=14
# Attendance poll: posted weekly on SESSION_POLL_WEEKDAY at SESSION_POLL_HOUR in
# SESSION_POLL_TZ. QUORUM_THRESHOLD is the yes-count at or above which the bot
# announces the session is on and posts payment; MAX_ATTENDEES caps it.
SESSION_POLL_WEEKDAY=thursday
SESSION_POLL_HOUR=20
SESSION_POLL_TZ=America/Los_Angeles
QUORUM_THRESHOLD=10
# Payment block (interpolated into the quorum announcement):
PAYMENT_EMAIL=you@example.com
PAYMENT_AMOUNT=7.5
ACCOUNTING_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
# Composite weights, one per indicator. All six must be listed: any indicator you
# omit falls back to its default, and an unknown key (e.g. the retired WEIGHT_DEFENSE)
# is silently dropped by pydantic's extra="ignore". They should sum to 1.0; the bot
# logs a warning at startup if they don't.
WEIGHT_ATTACK=0.1667
WEIGHT_RECEIVE=0.1667
WEIGHT_BLOCK=0.1667
WEIGHT_SETTING=0.1667
WEIGHT_SERVE=0.1666
WEIGHT_POSITIONING=0.1666
CALIBRATION_THRESHOLD=15
QUEUE_DEPTH=5
DATABASE_PATH=data/toop.db
# Don't-know alert thresholds (daily admin DM suggesting /pause_voting):
DK_ALERT_MIN_PROMPTS=10
DK_ALERT_RATE=0.5
DEFAULT_PAUSE_DAYS=14
SKIP_COOLDOWN_DAYS=7
# Rolling re-vote window: a score older than this many days is offered again,
# so ratings track how well people actually know each other.
REVOTE_AFTER_DAYS=60
# Weekly re-vote nudge: the day after the Monday session, clear of the Thursday
# attendance poll. Uses SESSION_POLL_TZ. Nobody is DMed twice inside the
# cooldown, or at all until they owe at least MIN_PENDING targets.
REVOTE_NUDGE_WEEKDAY=tuesday
REVOTE_NUDGE_HOUR=19
REVOTE_NUDGE_COOLDOWN_DAYS=7
REVOTE_NUDGE_MIN_PENDING=3
VPS_SSH=user@your-vps-ip
